# Copy to backend/.env. Every value here is a placeholder.
#
# Note what is NOT in this file: rates, margins, uplift percentages and
# minimum quote values. Those live in the database and are edited through
# /admin/rates and /admin/rules, because a rate change must be a data edit
# rather than a deployment.

AQM_ENVIRONMENT=development

# --- database -------------------------------------------------------------
AQM_DATABASE_URL=sqlite:///./dev.db
# AQM_DATABASE_URL=postgresql+psycopg2://aqm:password@localhost:5432/aqm

# --- attachment storage ---------------------------------------------------
AQM_STORAGE_BACKEND=local
AQM_STORAGE_ROOT=./storage
# AQM_STORAGE_BACKEND=azure
# AQM_AZURE_STORAGE_CONNECTION_STRING=
# AQM_AZURE_STORAGE_CONTAINER=quoting-attachments

# --- Anthropic (extraction, classification, note interpretation) ----------
AQM_ANTHROPIC_API_KEY=
AQM_ANTHROPIC_MODEL=claude-opus-5
AQM_ANTHROPIC_MAX_TOKENS=8000
# Route a policy decline to a fallback model rather than stalling an enquiry.
# The chain declining outright still raises; it never guesses.
AQM_ANTHROPIC_REFUSAL_FALLBACK=true
AQM_DRAWING_DPI=175

# --- confidence policy ----------------------------------------------------
# Spec section 8 leaves the thresholds open. A field scoring below its
# threshold is withheld from pricing and shown as unread.
AQM_CONFIDENCE_THRESHOLD_DEFAULT=0.80
AQM_CONFIDENCE_THRESHOLD_OVERRIDES='{"material":0.85,"tightest_tolerance":0.90,"quantity":0.90,"heat_treatment":0.85}'

# Spec section 8, open decision: may the AI propose processes the customer did
# not name? When they DID name processes the routing is constrained to those
# regardless of this setting.
AQM_PROPOSE_UNNAMED_PROCESSES=true

# --- Microsoft Graph ------------------------------------------------------
AQM_GRAPH_TENANT_ID=
AQM_GRAPH_CLIENT_ID=
AQM_GRAPH_CLIENT_SECRET=
AQM_GRAPH_QUOTING_MAILBOX=quotes@example.com
AQM_GRAPH_RFQ_CATEGORY=RFQ
# Shared secret echoed in every Graph notification; proves it came from us.
# Only needed once Graph can reach you at a public address. Until then the
# mailbox is polled instead — POST /intake/poll, or the "Check for new
# enquiries" button, or `python -m scripts.check_graph --poll`.
AQM_GRAPH_WEBHOOK_CLIENT_STATE=

# --- auth -----------------------------------------------------------------
# MUST be true in production. When false, approvals are recorded against an
# X-User-Email header, which is fine for local development and nowhere else.
AQM_AUTH_REQUIRED=false
AQM_ENTRA_TENANT_ID=
AQM_ENTRA_AUDIENCE=
